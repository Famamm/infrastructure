POSTGRES_USER=fleetops_admin_dev
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=fleetops_db_dev

DB_CONTAINER_NAME=fleetops_db_dev
DB_PORT=5433

API_ENVIRONMENT=Development
API_IMAGE=fleetopsapp/fleetops-api:dev
API_CONTAINER_NAME=fleetops_api_dev
API_PORT=1082

GPS_BATCH_INTERVAL_SECONDS=5

ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=fleetops_db_dev;Username=fleetops_admin_dev;Password=change-me-dev;SSL Mode=Prefer;

DOCKERHUB_USERNAME=change-me
DOCKERHUB_TOKEN=change-me
DOCKERHUB_IMAGE=fleetopsapp/fleetops-api

APP_IMAGE_TAG=dev
APP_NAME=fleetops-api

Jwt__Key=change-me
Jwt__Issuer=fleetops_backend
Jwt__Audience=fleetops_backend_users
Jwt__AccessTokenExpireMinutes=60
Jwt__RefreshTokenExpireDays=7

Cloudinary__CloudName=change-me
Cloudinary__ApiKey=change-me
Cloudinary__ApiSecret=change-me

SwaggerAuth__Username=change-me
SwaggerAuth__Password=change-me

# ===== Maintenance Reminder (H-7 / H-3 / H-1) =====
# Array pakai indexed key (__0, __1, __2). Urutan bebas, jumlah bebas.
MaintenanceReminder__ReminderDays__0=7
MaintenanceReminder__ReminderDays__1=3
MaintenanceReminder__ReminderDays__2=1

# Ambang odometer (km) untuk memicu reminder tingkat pertama
MaintenanceReminder__KmBefore=500

# Interval scan worker dalam menit (1440 = sekali sehari)
MaintenanceReminder__ScanIntervalMinutes=1440

# ===== Fuel Anomaly Detection =====
# Jumlah segmen konsumsi BBM terakhir yang dipakai sebagai baseline
FuelAnomaly__Window=5

# Minimum segmen agar baseline dianggap reliabel (>= nilai ini = reliable)
FuelAnomaly__MinSegments=3

# Ambang deviasi rasio (0.3 = 30%) sebelum dianggap anomali
FuelAnomaly__DeviationThreshold=0.3